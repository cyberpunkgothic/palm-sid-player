#include "resource.h"

VERSION ID 1 "1.0"
APPLICATIONICONNAME ID 1000 "SID Player DX"

// Launcher icons (the C= logo, drawn by tools/gen_icon.py): 1-bit and 8-bit, single and double density
ICONFAMILYEX
BEGIN
	BITMAP "icon_lg_1.bmp" BPP 1
	BITMAP "icon_lg_8.bmp" BPP 8 TRANSPARENT 255 255 255
	BITMAP "icon_lg2_1.bmp" BPP 1 DENSITY 2
	BITMAP "icon_lg2_8.bmp" BPP 8 TRANSPARENT 255 255 255 DENSITY 2
END

SMALLICONFAMILYEX
BEGIN
	BITMAP "icon_sm_1.bmp" BPP 1
	BITMAP "icon_sm_8.bmp" BPP 8 TRANSPARENT 255 255 255
	BITMAP "icon_sm2_1.bmp" BPP 1 DENSITY 2
	BITMAP "icon_sm2_8.bmp" BPP 8 TRANSPARENT 255 255 255 DENSITY 2
END

// The main form is empty: the app draws the whole C64-style screen itself (see drawScene in main.c).
// It is resized at run time to fill the screen (taller on the TX with the input area closed).
FORM ID MainForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID MainMenuBar
BEGIN
END

MENU ID MainMenuBar
BEGIN
	PULLDOWN "Options"
	BEGIN
		MENUITEM "Settings..." ID MenuSettings "S"
		MENUITEM "Speed Test" ID MenuSpeed "T"
		MENUITEM "About SID Player DX" ID MenuAbout "A"
	END
END

ALERT ID ErrorAlert
ERROR
BEGIN
	TITLE "SID Player"
	MESSAGE "^1^2^3"
	BUTTONS "OK"
END

// About box: a plain modal form rather than an alert, so it makes no alert sound and the app's own
// loop keeps running while it is open (the simulator's sound buffer is filled from that loop)
FORM ID AboutForm AT (2 38 156 120)
MODAL
USABLE
BEGIN
	TITLE "About SID Player DX"
	LABEL "SID Player DX 1.0" AUTOID AT (CENTER 16) FONT 1
	LABEL "C64 music with libsidplay 1.36.60" AUTOID AT (4 34)
	LABEL "by Michael Schwendt (SIDPLAY's" AUTOID AT (4 45)
	LABEL "original engine). GPL v2 or later." AUTOID AT (4 56)
	LABEL "Put .sid files in the SID folder" AUTOID AT (4 74)
	LABEL "on the card." AUTOID AT (4 85)
	BUTTON "OK" ID AboutOKButton AT (CENTER 103 36 12)
END

// Settings: own loop like the About box (see showSettings in main.c)
FORM ID SettingsForm AT (2 26 156 132)
MODAL
USABLE
DEFAULTBTNID SetCancelButton
BEGIN
	TITLE "Settings"
	LABEL "SID chip" AUTOID AT (4 18) FONT 1
	PUSHBUTTON "6581" ID SetModel6581 AT (56 17 30 12) GROUP 1
	PUSHBUTTON "8580" ID SetModel8580 AT (PREVRIGHT+1 PREVTOP 30 12) GROUP 1
	LABEL "Filter" AUTOID AT (4 36) FONT 1
	CHECKBOX "Emulate the filter" ID SetFilterCheck AT (54 35 98 12)
	LABEL "Clock" AUTOID AT (4 54) FONT 1
	PUSHBUTTON "Auto" ID SetClockAuto AT (56 53 30 12) GROUP 2
	PUSHBUTTON "PAL" ID SetClockPAL AT (PREVRIGHT+1 PREVTOP 30 12) GROUP 2
	PUSHBUTTON "NTSC" ID SetClockNTSC AT (PREVRIGHT+1 PREVTOP 30 12) GROUP 2
	LABEL "Auto: the tune's own clock," AUTOID AT (4 72)
	LABEL "or PAL if it doesn't say." AUTOID AT (4 83)
	LABEL "OK restarts the current song." AUTOID AT (4 98)
	BUTTON "OK" ID SetOKButton AT (4 116 36 12)
	BUTTON "Cancel" ID SetCancelButton AT (PREVRIGHT+5 PREVTOP 36 12)
END

// Speed test: shown while it runs (no buttons; the result comes in InfoAlert)
FORM ID SpeedForm AT (20 60 120 40)
MODAL
USABLE
BEGIN
	TITLE "Speed Test"
	LABEL "Making 10 s of music..." AUTOID AT (CENTER 20)
END

ALERT ID InfoAlert
INFORMATION
BEGIN
	TITLE "Speed Test"
	MESSAGE "^1^2^3"
	BUTTONS "OK"
END

DATA "code" ID 1 "code0001.bin"
